# Pinned toolchain and bundled programs. Sourced by build/fetch.sh, build/programs.sh and build/release.sh, and
# included by the Makefile (so: plain NAME=value lines; ${NAME} may refer to a name defined above it).
GO_VERSION=1.27.3
GO_SHA256_LINUX_AMD64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40

# Node 24.x LTS (Krypton). Checksums from https://nodejs.org/dist/v24.22.1/SHASUMS256.txt
NODE_VERSION=24.22.1
NODE_SHA256_LINUX_X64=6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6
NODE_SHA256_WIN_X64=d2046d28c2c3dcd211ac5145c0bf30e2047ef9dfb306693c8c6e2eccd8b95fa5

# ffmpeg, for the clips of the animated export: BtbN's FFmpeg-Builds, static, GPL (with libx264), ffmpeg 7.1.
# The release autobuild-2026-07-31-14-10 is the last month-end build that still has 7.1 (BtbN keeps the
# month-end ones); later builds are 8.1 and up. sha256 from that release's checksums.sha256 (and GitHub's
# asset digests), checked against the downloads on 2026-11-06.
FFMPEG_BUILD=autobuild-2026-07-31-14-10
FFMPEG_VERSION=n7.1.5-12-g1fdbca85aa
FFMPEG_URL_LINUX_X64=https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_BUILD}/ffmpeg-${FFMPEG_VERSION}-linux64-gpl-7.1.tar.xz
FFMPEG_SHA256_LINUX_X64=c1e6caf48923dd8e6bc5e54d51ba70c321175b8162ae9c414c392990e72f0e79
FFMPEG_URL_WIN_X64=https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_BUILD}/ffmpeg-${FFMPEG_VERSION}-win64-gpl-7.1.zip
FFMPEG_SHA256_WIN_X64=c067a1ca58f4fc4449f4bab0890fbcd65cbb3e5f46e066cf9c768e06c0c1d4d9
# Its source, mirrored in Stagepack's release assets: ffmpeg at the commit the build names (n7.1.5-12-g1fdbca85aa
# on release/7.1), and BtbN's build scripts at the commit the release tag points to, which name the repository
# and commit of every library linked in (build/ffmpeg-sources.tsv lists those). sha256 of GitHub's archives,
# downloaded twice on 2026-11-06 with the same result.
FFMPEG_COMMIT=1fdbca85aaea513c9cc6c14d347f76543346d3da
FFMPEG_SOURCE_URL=https://github.com/FFmpeg/FFmpeg/archive/${FFMPEG_COMMIT}.tar.gz
FFMPEG_SOURCE_SHA256=1312ecd4b87383182530278450c204c27e6787d033b190a28072a149cca59ed3
FFMPEG_BUILDS_COMMIT=a99e8230eae00d1cee38f23076a7a1f55cd984e2
FFMPEG_BUILDS_SOURCE_URL=https://github.com/BtbN/FFmpeg-Builds/archive/${FFMPEG_BUILDS_COMMIT}.tar.gz
FFMPEG_BUILDS_SOURCE_SHA256=7deac4a5190b2be84d4d548db2885d05152f9e3d77069d0e34841a46efd95e2b

# Build-time only (run with `go run`, not part of the program): icon and manifest resource tool, 0BSD.
WINRES_VERSION=v0.3.3
